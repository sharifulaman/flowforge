{
  "name": "@flowforge/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@flowforge/connector-sdk": "workspace:*",
    "@flowforge/connectors": "workspace:*",
    "@flowforge/db": "workspace:*",
    "@flowforge/engine": "workspace:*",
    "@flowforge/shared": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-fastify": "11.2.11",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.2",
    "bullmq": "5.81.6",
    "fastify": "5.12.8",
    "ioredis": "5.11.1",
    "jose": "6.2.18",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@flowforge/tsconfig": "workspace:*",
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.16.22",
    "@types/node": "22.18.12",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
