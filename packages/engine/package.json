{
  "name": "@flowforge/engine",
  "version": "0.0.0",
  "private": true,
  "description": "FlowForge runtime core shared by the API and the worker: credentials, SSRF-safe HTTP, publishing, run creation, trigger lifecycle and (phase c) execution.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flowforge/connector-sdk": "workspace:*",
    "@flowforge/db": "workspace:*",
    "@flowforge/shared": "workspace:*",
    "bullmq": "5.81.6",
    "@flowforge/safe-http": "workspace:*"
  },
  "devDependencies": {
    "@flowforge/connectors": "workspace:*",
    "@flowforge/tsconfig": "workspace:*",
    "@types/node": "22.18.12",
    "ioredis": "5.11.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "files": [
    "dist"
  ]
}
