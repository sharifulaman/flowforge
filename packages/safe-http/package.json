{
  "name": "@flowforge/safe-http",
  "version": "0.0.0",
  "private": true,
  "description": "SSRF-protected HTTP client used by connectors (private-IP blocking at DNS and connect time, redirect re-validation, timeouts, size caps).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flowforge/connector-sdk": "workspace:*",
    "ipaddr.js": "2.5.0",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@flowforge/tsconfig": "workspace:*",
    "@types/node": "22.18.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
