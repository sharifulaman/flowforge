{
  "name": "@flowforge/shared",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "10.4.0",
    "zod": "4.6.7",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@flowforge/tsconfig": "workspace:*",
    "@types/node": "22.18.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "files": [
    "dist"
  ]
}
