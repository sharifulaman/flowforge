{
  "name": "flowforge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @flowforge/db generate",
    "db:migrate": "pnpm --filter @flowforge/db migrate:dev",
    "db:deploy": "pnpm --filter @flowforge/db migrate:deploy",
    "db:seed": "pnpm --filter @flowforge/db seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@swc/core",
      "esbuild",
      "isolated-vm",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
