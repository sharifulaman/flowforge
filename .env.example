# ─── Core ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Data stores ─────────────────────────────────────────
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge?schema=public
REDIS_URL=redis://localhost:6379

# ─── URLs ────────────────────────────────────────────────
# Browser-facing origin of the web app. The web app proxies /api/* to the API,
# so cookies are first-party and no CORS is needed.
WEB_URL=http://localhost:3000
# Where the Next.js server reaches the API (server-side only).
API_INTERNAL_URL=http://localhost:4000
# Public base URL for inbound webhooks (/hooks/:token).
HOOKS_PUBLIC_URL=http://localhost:4000
API_PORT=4000

# ─── Secrets (generate your own!) ────────────────────────
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# openssl rand -base64 32   (must decode to exactly 32 bytes)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ENCRYPTION_KEY_VERSION=1

# Set to true behind HTTPS in production.
COOKIE_SECURE=false

# ─── Google OAuth (login + Google Sheets connections) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ─── Worker ──────────────────────────────────────────────
RUN_CONCURRENCY=10
CODE_MEMORY_MB=64
CODE_TIMEOUT_MS=5000
# Switch a Zap off after this many consecutive failed runs (0 = never).
AUTO_PAUSE_AFTER_FAILURES=10

# ─── Development only ────────────────────────────────────
# Hosts exempt from SSRF blocking (e.g. "localhost,127.0.0.1" to call services on your
# machine from HTTP steps). NEVER set this in production.
HTTP_ALLOW_PRIVATE_HOSTS=

# ─── docker compose only ─────────────────────────────────
# POSTGRES_PASSWORD=flowforge
# WEB_PORT=3000
# API_PORT=4000
